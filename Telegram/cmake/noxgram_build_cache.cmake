# Faster local macOS builds with the Xcode generator:
# - every compile goes through ccache when it is installed, so a file whose
#   sources did not change is taken from the cache after a reconfigure, a
#   branch switch or a build of another configuration or architecture;
# - Xcode does not write an index store while building.
# NOXGRAM_CCACHE=OFF turns the cache off.

if (NOT APPLE OR NOT CMAKE_GENERATOR STREQUAL Xcode)
    return()
endif()

set(CMAKE_XCODE_ATTRIBUTE_COMPILER_INDEX_STORE_ENABLE NO)

option(NOXGRAM_CCACHE "Compile through ccache when it is installed." ON)
if (NOT NOXGRAM_CCACHE)
    return()
endif()
find_program(NOXGRAM_CCACHE_PROGRAM ccache)
if (NOT NOXGRAM_CCACHE_PROGRAM)
    message(STATUS "NoxGram: ccache not found, compiling without a cache.")
    return()
endif()

function(noxgram_ccache_launcher name compiler)
    set(path ${CMAKE_BINARY_DIR}/${name})
    file(WRITE ${path}.in [=[#!/bin/bash
# Generated by Telegram/cmake/noxgram_build_cache.cmake.
# Drops the SDK stat cache option, which ccache can't hash, and builds
# precompiled headers without a timestamp, so they can be cached too.
args=()
skip=0
header=0
for arg in "$@"; do
	if [ $skip = 1 ]; then
		skip=0
		continue
	fi
	case "$arg" in
		-ivfsstatcache) skip=1; continue ;;
		c-header|c++-header|objective-c-header|objective-c++-header) header=1 ;;
	esac
	args+=("$arg")
done
if [ $header = 1 ]; then
	args+=(-Xclang -fno-pch-timestamp)
fi
export CCACHE_SLOPPINESS=pch_defines,time_macros,include_file_mtime,include_file_ctime,clang_index_store,ivfsoverlay
export CCACHE_BASEDIR="@NOXGRAM_SOURCE_ROOT@"
exec "@NOXGRAM_CCACHE_PROGRAM@" "@NOXGRAM_COMPILER@" "${args[@]}"
]=])
    set(NOXGRAM_COMPILER ${compiler})
    get_filename_component(NOXGRAM_SOURCE_ROOT "${CMAKE_SOURCE_DIR}/.." REALPATH)
    configure_file(${path}.in ${path} @ONLY
        FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
            GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endfunction()

noxgram_ccache_launcher(noxgram-ccache-c ${CMAKE_C_COMPILER})
noxgram_ccache_launcher(noxgram-ccache-cxx ${CMAKE_CXX_COMPILER})

set(CMAKE_XCODE_ATTRIBUTE_CC ${CMAKE_BINARY_DIR}/noxgram-ccache-c)
set(CMAKE_XCODE_ATTRIBUTE_CXX ${CMAKE_BINARY_DIR}/noxgram-ccache-cxx)
set(CMAKE_XCODE_ATTRIBUTE_LD ${CMAKE_C_COMPILER})
set(CMAKE_XCODE_ATTRIBUTE_LDPLUSPLUS ${CMAKE_CXX_COMPILER})
message(STATUS "NoxGram: compiling through ${NOXGRAM_CCACHE_PROGRAM}.")
